# Medição do site. Copie este arquivo para .env e preencha.
#
# Estes valores entram no código na hora do `npm run build`, então mudar o .env
# pede build e publicação novos. Deixando tudo em branco, o site não carrega
# tag nenhuma, o banner de cookies não aparece e a política de privacidade
# volta a dizer que o site não mede audiência.

# GA4, em Administrador, Fluxos de dados, ID de métricas
VITE_GA_ID=G-XXXXXXXXXX

# Google Ads, em Ferramentas, Conversões: é o mesmo para a conta inteira
VITE_ADS_ID=AW-000000000

# Rótulo de cada conversão, na mesma tela do Ads, em Instalar a tag,
# Instalar manualmente. É a parte depois da barra em send_to.
# Sem o rótulo o clique vira evento no GA4, mas não conta como conversão no Ads
VITE_ADS_LABEL_WHATSAPP=
VITE_ADS_LABEL_TELEFONE=
